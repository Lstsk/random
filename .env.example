# Required for the default models.
ANTHROPIC_API_KEY=

# Any Pydantic AI model string works, e.g. openai:<model> or openrouter:<vendor>/<model>.
PLANNER_MODEL=anthropic:claude-sonnet-5-5
LABELER_MODEL=anthropic:claude-haiku-4-5

# Only needed when switching providers.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
